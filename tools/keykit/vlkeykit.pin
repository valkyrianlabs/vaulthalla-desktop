# The vl-keykit source VLKeykit.xcframework is built from (tools/keykit/build-vlkeykit.sh). Shell syntax, sourced.
#
# VLKEYKIT_SOURCE is one of
#   file:<path in this repository>#sha256=<hex digest>      a source tarball committed here, checked before it is unpacked
#   git+<repository URL or local path>#<full commit>       a revision, cloned and checked out
#   <https URL of a release tarball>#sha256=<hex digest>    a release, downloaded and checked before it is unpacked
#
# The tarball is committed (as vaulthalla-server and vaulthalla-cloud commit theirs under subprojects/packagecache), so
# no build, CI included, needs a token for the private vl-keykit repository. This one is
# `git archive --format=tar.gz --prefix=vl-keykit-0.4.0/ ab42505bee0dc559a5ffb4cda30c84dca8c1a6df` of vl-keykit branch
# feat/capi-credential (0.4.0: the sealed storage credential in the C API; not yet merged or tagged; the archive is
# reproducible from that commit); replace it with the v0.4.0 release tarball once that is published.
VLKEYKIT_VERSION=0.4.0
VLKEYKIT_SOURCE=file:tools/keykit/vendor/vl-keykit-0.4.0-ab42505b.tar.gz#sha256=aa8754313b11989756da30f15da069bce7013fda8b7e4006c58d883ae034e079
