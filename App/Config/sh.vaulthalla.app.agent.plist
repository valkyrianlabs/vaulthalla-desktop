<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The background agent (BackgroundAgent.swift, valkyrianlabs/vaulthalla-desktop#5): the app's own executable in its
     headless mode, registered with SMAppService.agent while any vault is in Finder. It exits once none is, so launchd
     restarts it only after a crash. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>sh.vaulthalla.app.agent</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/Vaulthalla</string>
	<key>ProgramArguments</key>
	<array>
		<string>Contents/MacOS/Vaulthalla</string>
		<string>--agent</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>sh.vaulthalla.app</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
